EverythingUnion = (
	; Each specific form comes before its general type, since the union is decoded in order.
	(uint_single: 10) /
	(uint_range: 15..20) /
	uint /
	(nint_single: -2) /
	(nint_range: -10..-5) /
	nint /
	(bstr_single: 'foo') /
	(bstr_size: bstr .size 3) /
	(bstr_cbor: bstr .cbor uint) /
	bstr /
	(tstr_single: "bar") /
	(tstr_size: tstr .size 5) /
	tstr /
	(empty_list: []) /
	(list: [
		+uint,
		+nint
	]) /
	; After the other lists, since it matches any list with one element.
	(any_list: [any]) /
	(empty_map: {}) /
	(map: {
		(1 => "one") / (2 => "two")
	}) /
	(bool_single: true) /
	bool /
	nil /
	undefined /
	(float16_single: 3.140625) /
	float16 /
	(float32_single: 1.10004723072052) /
	float32 /
	(float64_single: -6.28) /
	float64 /
	; Only chosen when encoding, since uint (above) matches each uint first when decoding.
	(repeated: +uint)
)

EverythingList = [* EverythingUnion]
