; Used by tests/encode/test5_defines, which changes the values of the #defines generated by
; --defines before compiling the code.

Values = [
	uint_val: 5,
	nint_val: -5,
	tstr_val: "hello",
	bstr_val: 'abc',
	float_val: 1.5,
	bool_val: true,
]

KeyValues = {
	1 => uint,
	"key" => uint,
}

; The integers that start the members of value_union and key_union are also the enum values of
; the choice variables. This is not the case for tagged_union, since its members start with tags.
UnionValues = [
	value_union: (1 / 2 / 3),
	key_union: {(2 => tstr) // (3 => bstr)},
	tagged_union: (#6.1(1) / #6.2(2)),
]

Ranges = [
	uint_range: 10..20,
	int_range: int .gt -20 .lt -10,
	float_range: float .ge 1.5 .le 2.5,
]

Bits = uint .bits flags

flags = &(
	flag0: 0,
	flag1: 1,
	flag3: 3,
)

Sizes = [
	fixed_bstr: bstr .size 3,
	ranged_tstr: tstr .size 2..4,
]

Defaults = [
	? uint_default: uint .default 5,
	? tstr_default: tstr .default "abc",
]

Quantities = [
	range_qty: [2*5 uint],
	exact_qty: [3*3 uint],
]

DefaultQty = [
	uints: [* uint],
	groups: [+ (a: uint, b: tstr)],
	map: {* uint => bool},
]

Tags = [
	tagged_uint: #6.1234(uint),
	tagged_tstr: #6.5678(tstr),
]

Nested = [0*2 [0*2 [0*2 uint]]]

Counts = [
	a: uint,
	b: {"c" => uint},
]
